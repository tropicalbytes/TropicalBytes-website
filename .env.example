# URL of the deployed Google Apps Script Web App (see /google-apps-script/README.md)
NEXT_PUBLIC_GAS_WEB_APP_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec

# Supabase (Project Settings → API). Public by design: RLS is what protects the data.
# Read by lib/catalog (not yet used by public pages) and the CSP in next.config.mjs.
# Without them the site keeps working from lib/config.ts.
NEXT_PUBLIC_SUPABASE_URL=https://bftbqypdbbcqmxsaisxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only, for future admin scripts. NEVER prefix with NEXT_PUBLIC_ and never import into client code.
# SUPABASE_SERVICE_ROLE_KEY=
